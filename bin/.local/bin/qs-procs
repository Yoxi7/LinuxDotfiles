#!/usr/bin/env python3
"""
qs-procs - Process inspector for Quickshell window switcher
Accepts a list of terminal PIDs and returns a JSON mapping of pid -> foreground process
"""

import sys
import os
import json
import subprocess

def get_child_process(pid_str):
    try:
        pid = int(pid_str)
        # Find deepest child process
        children = subprocess.check_output(
            ["pgrep", "-P", str(pid)],
            text=True, stderr=subprocess.DEVNULL
        ).strip().split()
        if children:
            target_pid = children[-1]
        else:
            target_pid = str(pid)

        with open(f"/proc/{target_pid}/comm", "r", encoding="utf-8") as f:
            return f.read().strip()
    except Exception:
        return ""

def main():
    pids = sys.argv[1:]
    res = {}
    for p in pids:
        cmd = get_child_process(p)
        if cmd:
            res[p] = cmd
    print(json.dumps(res))

if __name__ == "__main__":
    main()
