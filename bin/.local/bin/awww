#!/usr/bin/env bash
# Wrapper: transparently redirect awww calls to swww if swww is present
if command -v swww &>/dev/null; then
    exec swww "$@"
elif command -v /usr/bin/awww &>/dev/null; then
    exec /usr/bin/awww "$@"
else
    echo "awww/swww: neither swww nor awww was found in PATH." >&2
    exit 1
fi
