#!/usr/bin/env bash
# ==============================================================================
# wallpick - Wallpaper setter supporting swww and Retro Sakura accent extraction
# Usage: wallpick [--anim <anim>] [--resize <mode>] [--gravity <grav>]
#                 [--fill <color>] [--outputs <outs>] <image_path>
# ==============================================================================

set -e

ANIM="dynamic"
RESIZE="crop"
GRAVITY="center"
FILL=""
OUTPUTS=""
TARGET_IMG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --anim)
            ANIM="$2"; shift 2 ;;
        --resize)
            RESIZE="$2"; shift 2 ;;
        --gravity)
            GRAVITY="$2"; shift 2 ;;
        --fill)
            FILL="$2"; shift 2 ;;
        --outputs)
            OUTPUTS="$2"; shift 2 ;;
        *)
            TARGET_IMG="$1"; shift ;;
    esac
done

if [[ -z "$TARGET_IMG" || ! -f "$TARGET_IMG" ]]; then
    echo "wallpick: image not specified or does not exist: $TARGET_IMG" >&2
    exit 1
fi

# Ensure awww/swww daemon is running
WALL_CMD=""
DAEMON_CMD=""

if command -v awww &>/dev/null; then
    WALL_CMD="awww"
    DAEMON_CMD="awww-daemon"
elif command -v swww &>/dev/null; then
    WALL_CMD="swww"
    DAEMON_CMD="swww-daemon"
fi

if [[ -n "$WALL_CMD" ]]; then
    if ! pgrep -x "$DAEMON_CMD" >/dev/null; then
        "$DAEMON_CMD" >/dev/null 2>&1 &
        sleep 0.3
    fi

    WALL_ARGS=()
    if [[ "$ANIM" != "none" ]]; then
        case "$ANIM" in
            fade)   WALL_ARGS+=(--transition-type fade --transition-duration 1) ;;
            wipe)   WALL_ARGS+=(--transition-type wipe --transition-angle 30) ;;
            grow)   WALL_ARGS+=(--transition-type grow --transition-pos 0.5,0.5) ;;
            wave)   WALL_ARGS+=(--transition-type wave --transition-angle 45) ;;
            *)      WALL_ARGS+=(--transition-type any --transition-step 90 --transition-fps 60) ;;
        esac
    else
        WALL_ARGS+=(--transition-type none)
    fi

    if [[ -n "$OUTPUTS" ]]; then
        IFS=',' read -ra OUT_LIST <<< "$OUTPUTS"
        for out in "${OUT_LIST[@]}"; do
            "$WALL_CMD" img -o "$out" "${WALL_ARGS[@]}" "$TARGET_IMG"
        done
    else
        "$WALL_CMD" img "${WALL_ARGS[@]}" "$TARGET_IMG"
    fi
elif command -v swaybg &>/dev/null; then
    pkill -x swaybg || true
    swaybg -m "$RESIZE" -i "$TARGET_IMG" &
fi

# Generate accent colors in background
if command -v wall-accent &>/dev/null; then
    wall-accent "$TARGET_IMG" >/dev/null 2>&1 &
fi
